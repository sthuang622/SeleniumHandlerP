    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Selenium_Handler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FileConfig\**" />
    <Compile Remove="Scripts\**" />
    <Compile Remove="SeleniumScripts\**" />
    <Content Remove="FileConfig\**" />
    <Content Remove="Scripts\**" />
    <Content Remove="SeleniumScripts\**" />
    <EmbeddedResource Remove="FileConfig\**" />
    <EmbeddedResource Remove="Scripts\**" />
    <EmbeddedResource Remove="SeleniumScripts\**" />
    <None Remove="FileConfig\**" />
    <None Remove="Scripts\**" />
    <None Remove="SeleniumScripts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Selenium.Support" Version="4.49.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.49.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DTO\" />
  </ItemGroup>

</Project>
