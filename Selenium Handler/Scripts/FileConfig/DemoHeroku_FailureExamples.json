{
  "api": "https://the-internet.herokuapp.com",
  "name": "Demo Heroku - Failure Examples",
  "description": "Public demo tests intentionally designed to fail in different ways: script syntax error, missing element, wrong assertion, and timeout. Use this fileconfig to demonstrate failure reporting, screenshots, and error messages.",
  "params": {
    "missingSelector": "#this-element-does-not-exist",
    "wrongExpectedText": "This text should not exist",
    "timeoutSelector": "#never-appears"
  },
  "tests": [
    {
      "testConfig": "TestConfig/DemoHeroku_Failure_SyntaxError.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_Failure_MissingElement.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_Failure_WrongText.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_Failure_Timeout.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_SkippedAfterFailure.json",
      "dependency": "Demo Heroku - Failure: Missing Element"
    }
  ]
}
