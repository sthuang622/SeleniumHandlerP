{
  "name": "Demo Heroku - Dynamic Loading",
  "description": "Start a dynamic loading example, wait for text, and store the loaded text in runtime params.",
  "testSteps": [
    {
      "name": "Open dynamic loading page",
      "description": "Navigate to dynamic loading example 2.",
      "seleniumScript": "DemoHeroku_OpenDynamicLoadingPage.cs"
    },
    {
      "name": "Start dynamic loading",
      "description": "Click Start on the dynamic loading example.",
      "seleniumScript": "DemoHeroku_StartDynamicLoading.cs"
    },
    {
      "name": "Verify hello world loaded",
      "description": "Wait for Hello World text and store it in runtime params.",
      "seleniumScript": "DemoHeroku_VerifyHelloWorldLoaded.cs",
      "dependency": "Start dynamic loading"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
