{
  "name": "Demo Heroku - Dropdown",
  "description": "Select a configured dropdown option and verify the selected text.",
  "testSteps": [
    {
      "name": "Open dropdown page",
      "description": "Navigate to the public dropdown demo page.",
      "seleniumScript": "DemoHeroku_OpenDropdownPage.cs"
    },
    {
      "name": "Select dropdown option",
      "description": "Select dropdown value {dropdownValue}.",
      "seleniumScript": "DemoHeroku_SelectDropdownOption.cs"
    },
    {
      "name": "Verify dropdown selection",
      "description": "Verify the configured dropdown value was selected and store the selected text.",
      "seleniumScript": "DemoHeroku_VerifyDropdownSelection.cs",
      "dependency": "Select dropdown option"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
