{
  "name": "Demo Heroku - Hovers",
  "description": "Hover over an avatar and verify its caption becomes visible.",
  "testSteps": [
    {
      "name": "Open hovers page",
      "description": "Navigate to the public hovers demo page.",
      "seleniumScript": "DemoHeroku_OpenHoversPage.cs"
    },
    {
      "name": "Hover first avatar",
      "description": "Move the mouse over the first avatar card.",
      "seleniumScript": "DemoHeroku_HoverFirstAvatar.cs"
    },
    {
      "name": "Verify hover caption",
      "description": "Verify the hover caption for user1 is visible.",
      "seleniumScript": "DemoHeroku_VerifyHoverCaption.cs",
      "dependency": "Hover first avatar"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
