{
  "name": "Demo Heroku - Login Failure",
  "description": "Try invalid credentials and verify the expected error message appears.",
  "testSteps": [
    {
      "name": "Open login page",
      "description": "Navigate to the public login demo page.",
      "seleniumScript": "DemoHeroku_OpenLoginPage.cs"
    },
    {
      "name": "Enter invalid credentials",
      "description": "Enter username {invalidUsername} and an invalid password.",
      "seleniumScript": "DemoHeroku_EnterInvalidCredentials.cs"
    },
    {
      "name": "Submit login",
      "description": "Submit the login form.",
      "seleniumScript": "DemoHeroku_SubmitLogin.cs"
    },
    {
      "name": "Verify login error",
      "description": "Verify the login failure message is shown.",
      "seleniumScript": "DemoHeroku_VerifyLoginError.cs"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
