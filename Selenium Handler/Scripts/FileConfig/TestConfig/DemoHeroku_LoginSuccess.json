{
  "name": "Demo Heroku - Login Success",
  "description": "Log in with valid public demo credentials and verify the secure area is shown.",
  "testSteps": [
    {
      "name": "Open login page",
      "description": "Navigate to the public login demo page.",
      "seleniumScript": "DemoHeroku_OpenLoginPage.cs"
    },
    {
      "name": "Enter valid credentials",
      "description": "Enter username {validUsername} and the configured password.",
      "seleniumScript": "DemoHeroku_EnterValidCredentials.cs"
    },
    {
      "name": "Submit login",
      "description": "Submit the login form.",
      "seleniumScript": "DemoHeroku_SubmitLogin.cs"
    },
    {
      "name": "Verify secure area",
      "description": "Verify secure area loaded and store login status in runtime params.",
      "seleniumScript": "DemoHeroku_VerifySecureArea.cs"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
