{
  "name": "Demo Heroku - Failure: Timeout Waiting For Element",
  "description": "This test intentionally waits for an element that never appears to demonstrate timeout failure reporting.",
  "testSteps": [
    {
      "name": "Open dynamic loading page",
      "description": "Navigate to the public dynamic loading demo page.",
      "seleniumScript": "DemoHeroku_OpenDynamicLoadingPage.cs"
    },
    {
      "name": "Wait for missing element timeout",
      "description": "Wait for selector {timeoutSelector}. This selector is intentionally absent and should timeout.",
      "seleniumScript": "DemoHeroku_Failure_Timeout.cs"
    }
  ],
  "chromeDriver": {
    "userProfilePreferences": {
      "credentials_enable_service": false,
      "profile.password_manager_enabled": false,
      "profile.password_manager_leak_detection": false,
      "password_manager_leak_detection": false,
      "safebrowsing.enabled": false
    },
    "arguments": [
      "--disable-save-password-bubble",
      "--disable-notifications",
      "--disable-features=PasswordLeakDetection,PasswordManagerOnboarding,AutofillServerCommunication"
    ]
  },
  "scriptOptions": {
    "references": [
      "object",
      "Enumerable",
      "IWebDriver",
      "ChromeDriver",
      "WebDriverWait",
      "TestConfig"
    ],
    "imports": [
      "System",
      "System.Collections.Generic",
      "System.Linq",
      "System.Threading",
      "OpenQA.Selenium",
      "OpenQA.Selenium.Chrome",
      "OpenQA.Selenium.Support.UI",
      "Selenium_Handler.Vo"
    ]
  }
}
