{
  "api": "https://the-internet.herokuapp.com",
  "name": "Demo Heroku - Login and Session",
  "description": "Public demo tests for login success, login failure, and logout/session behavior on the-internet.herokuapp.com.",
  "params": {
    "validUsername": "tomsmith",
    "validPassword": "SuperSecretPassword!",
    "invalidUsername": "bad-user",
    "invalidPassword": "bad-password"
  },
  "tests": [
    {
      "testConfig": "TestConfig/DemoHeroku_LoginSuccess.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_LoginFailure.json"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_LogoutAfterLogin.json",
      "dependency": "Demo Heroku - Login Success"
    },
    {
      "testConfig": "TestConfig/DemoHeroku_IntentionalFailure.json"
    }
  ]
}
